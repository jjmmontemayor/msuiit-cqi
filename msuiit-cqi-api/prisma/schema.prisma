// MSU-IIT CQI data model.
// See ../../docs/schema.md for the full design rationale and ER diagram.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Catalog (institution-wide, program-independent)
// ---------------------------------------------------------------------------

model Program {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  curriculumCourses    CurriculumCourse[]
  plos                 Plo[]
  cohorts              Cohort[]
  students             Student[]
  userRoles            UserProgramRole[]
  mappingLevels        MappingLevel[]
  attainmentBenchmark  AttainmentBenchmark?
  faculty              Faculty[]

  @@map("programs")
}

model Course {
  id            String   @id @default(uuid())
  code          String   @unique
  title         String
  description   String?
  credits       Int?
  lectureHours  Int?     @map("lecture_hours")
  labHours      Int?     @map("lab_hours")
  prerequisites String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  curriculumCourses CurriculumCourse[]
  clos              Clo[]
  courseOfferings   CourseOffering[]

  @@map("courses")
}

enum MappingLevelCode {
  I
  P
  D
}

// Weights are program-specific (each program can tune how I/P/D translate
// into a weighted score), so this is one row per (program, code) rather
// than a single global row per code. Not directly related to CloPloMapping
// at the Prisma level -- CloPloMapping.levelCode is a bare enum, and the
// applicable weight is looked up by (the mapping's cohort's program, code)
// in the reporting views and the admin weight-computation table.
model MappingLevel {
  id        String           @id @default(uuid())
  programId String           @map("program_id")
  code      MappingLevelCode
  label     String
  weight    Int

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, code])
  @@map("mapping_levels")
}

// One row per program: the score threshold below which a student's CLO
// attainment is flagged in reports -- source workbook calls this the
// "Performance Criteria" (Benchmark/Target, both 70% there) and uses it to
// decide "Good Standing" per student and the ✅/❌ "CQI Alert" per course.
model AttainmentBenchmark {
  id         String @id @default(uuid())
  programId  String @unique @map("program_id")
  percentage Int    @default(70)

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("attainment_benchmarks")
}

enum Semester {
  FIRST
  SECOND
  SUMMER

  @@map("semester")
}

model AcademicTerm {
  id              String   @id @default(uuid())
  schoolYearStart Int      @map("school_year_start")
  schoolYearEnd   Int      @map("school_year_end")
  semester        Semester
  label           String

  courseOfferings CourseOffering[]

  @@unique([schoolYearStart, schoolYearEnd, semester])
  @@map("academic_terms")
}

// ---------------------------------------------------------------------------
// Program structure
// ---------------------------------------------------------------------------

model CurriculumCourse {
  id            String  @id @default(uuid())
  programId     String  @map("program_id")
  courseId      String  @map("course_id")
  electiveGroup String? @map("elective_group")
  yearLevel     Int?    @map("year_level")
  term          String?
  displayOrder  Int     @default(0) @map("display_order")
  isActive      Boolean @default(true) @map("is_active")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([programId, courseId])
  @@map("curriculum_courses")
}

model Plo {
  id           String @id @default(uuid())
  programId    String @map("program_id")
  code         String
  description  String
  displayOrder Int    @default(0) @map("display_order")

  program               Program                @relation(fields: [programId], references: [id], onDelete: Cascade)
  performanceIndicators PerformanceIndicator[]
  cloMappings           CloPloMapping[]

  @@unique([programId, code])
  @@map("plos")
}

model PerformanceIndicator {
  id           String @id @default(uuid())
  ploId        String @map("plo_id")
  code         String
  description  String
  displayOrder Int    @default(0) @map("display_order")

  plo         Plo             @relation(fields: [ploId], references: [id], onDelete: Cascade)
  cloMappings CloPloMapping[]
  evaluations PiEvaluation[]

  @@unique([ploId, code])
  @@map("performance_indicators")
}

// `cohortId` scopes the CLO itself to one batch, the same way CloPloMapping
// is cohort-scoped: curricula get revised between batches, and a course's
// CLOs can be rewritten outright (not just re-mapped) for a later cohort.
// `isLocked` marks a CLO (and by extension its mappings) as finalized for
// reporting; a locked CLO can't be edited or deleted in place — instead, a
// new CLO row is created under the next cohort ("a new version"), leaving
// the locked one and its historical mappings/attainments untouched.
model Clo {
  id           String  @id @default(uuid())
  courseId     String  @map("course_id")
  cohortId     String  @map("cohort_id")
  code         String
  description  String
  displayOrder Int     @default(0) @map("display_order")
  isLocked     Boolean @default(false) @map("is_locked")

  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  cohort      Cohort          @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  ploMappings CloPloMapping[]
  attainments CloAttainment[]

  @@unique([courseId, code, cohortId])
  @@map("clos")
}

// The CLO->PLO mapping level (I/P/D) is the primary fact — every course's
// CLOs are mapped straight to all applicable PLOs (see the workbook's
// `Mapping` sheet, which has no PI column at all). `piId` is an optional
// refinement: once a program elaborates a PLO into specific Performance
// Indicators (as the `PLO Attainment Evaluation` sheet does, so far only for
// PLO1 in the source workbook), the same CLO/PLO pairing can additionally be
// tagged with which PI it evidences and how it's assessed. Making PI
// mandatory here would make it impossible to import/record a CLO->PLO
// mapping before every PI has been written up.
//
// `cohortId` scopes the mapping to one batch: curricula get revised over
// time, so the same CLO can map to a PLO at a different I/P/D level (or not
// at all) for a later batch. Each cohort therefore owns its own complete
// mapping set rather than sharing one global table.
model CloPloMapping {
  id               String           @id @default(uuid())
  cloId            String           @map("clo_id")
  ploId            String           @map("plo_id")
  cohortId         String           @map("cohort_id")
  levelCode        MappingLevelCode @map("level_code")
  piId             String?          @map("pi_id")
  assessmentMethod String?          @map("assessment_method")

  clo    Clo                   @relation(fields: [cloId], references: [id], onDelete: Cascade)
  plo    Plo                   @relation(fields: [ploId], references: [id], onDelete: Cascade)
  cohort Cohort                @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  pi     PerformanceIndicator? @relation(fields: [piId], references: [id], onDelete: SetNull)

  @@unique([cloId, ploId, cohortId])
  @@map("clo_plo_mappings")
}

// ---------------------------------------------------------------------------
// People and enrollment
// ---------------------------------------------------------------------------

model Cohort {
  id          String  @id @default(uuid())
  programId   String  @map("program_id")
  code        String
  startYear   Int     @map("start_year")
  endYear     Int     @map("end_year")
  description String?

  program         Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  students        Student[]
  evaluations     PiEvaluation[]
  cloPloMappings  CloPloMapping[]
  clos            Clo[]
  cohortAdvisers  CohortAdviser[]

  @@unique([programId, code])
  @@map("cohorts")
}

// Per-program faculty roster. Not tied to a User/login account (this app
// doesn't have auth-gated faculty accounts yet) -- a lightweight roster so a
// faculty member can be assigned as an adviser to one of the program's
// batches.
model Faculty {
  id        String  @id @default(uuid())
  programId String  @map("program_id")
  name      String
  email     String?
  isActive  Boolean @default(true) @map("is_active")

  program        Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  cohortAdvisers CohortAdviser[]

  @@map("faculty")
}

// Faculty <-> Cohort adviser assignment. A batch can have more than one
// adviser (e.g. co-advisers, or a handoff mid-batch), and a faculty member
// can advise more than one batch at a time, hence a plain join table rather
// than a single adviserId column on Cohort or Student.
model CohortAdviser {
  id        String @id @default(uuid())
  cohortId  String @map("cohort_id")
  facultyId String @map("faculty_id")

  cohort  Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([cohortId, facultyId])
  @@map("cohort_advisers")
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  WITHDRAWN

  @@map("student_status")
}

// `cohortId` is nullable: a student who shows up in an uploaded CLO
// attainment sheet but isn't part of this program's tracked roster (found
// no batch to place them in) still gets a Student row so their
// enrollments/attainments can be recorded against the course, but with no
// cohort -- which is exactly what excludes them from every cohort-scoped
// report (CLO/PLO Attainments, weighted PLO rollups, etc.) without needing
// a separate flag.
model Student {
  id            String        @id @default(uuid())
  studentNumber String        @unique @map("student_number")
  firstName     String        @map("first_name")
  lastName      String        @map("last_name")
  programId     String        @map("program_id")
  cohortId      String?       @map("cohort_id")
  status        StudentStatus @default(ACTIVE)

  program     Program      @relation(fields: [programId], references: [id], onDelete: Restrict)
  cohort      Cohort?      @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]

  @@map("students")
}

model CourseOffering {
  id             String  @id @default(uuid())
  courseId       String  @map("course_id")
  academicTermId String  @map("academic_term_id")
  section        String?
  instructorName String? @map("instructor_name")

  course       Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  academicTerm AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  enrollments  Enrollment[]

  @@unique([courseId, academicTermId, section])
  @@map("course_offerings")
}

model Enrollment {
  id               String @id @default(uuid())
  studentId        String @map("student_id")
  courseOfferingId String @map("course_offering_id")
  // What year level the student was in when they took this specific
  // course -- distinct from the course offering's academic term (a
  // calendar period), since two students in the same offering can be at
  // different points in their own program (e.g. one on-track, one
  // repeating), and the same course can be taken at different year levels
  // across cohorts as curricula get revised.
  yearLevel        Int?   @map("year_level")

  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering  @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  cloAttainments CloAttainment[]

  @@unique([studentId, courseOfferingId])
  @@map("enrollments")
}

// ---------------------------------------------------------------------------
// Facts
// ---------------------------------------------------------------------------

model CloAttainment {
  id           String  @id @default(uuid())
  enrollmentId String  @map("enrollment_id")
  cloId        String  @map("clo_id")
  score        Decimal @db.Decimal(5, 2)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  clo        Clo        @relation(fields: [cloId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, cloId])
  @@map("clo_attainments")
}

// ---------------------------------------------------------------------------
// Evaluation (narrative)
// ---------------------------------------------------------------------------

enum EvaluationStatus {
  DRAFT
  FINAL

  @@map("evaluation_status")
}

model PiEvaluation {
  id                   String           @id @default(uuid())
  piId                 String           @map("pi_id")
  cohortId             String           @map("cohort_id")
  benchmarkDescription String?          @map("benchmark_description")
  targetPercentage     Decimal?         @map("target_percentage") @db.Decimal(5, 2)
  resultsNarrative     String?          @map("results_narrative")
  status               EvaluationStatus @default(DRAFT)
  createdById          String?          @map("created_by")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  pi        PerformanceIndicator @relation(fields: [piId], references: [id], onDelete: Cascade)
  cohort    Cohort               @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  createdBy User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([piId, cohortId])
  @@map("pi_evaluations")
}

// ---------------------------------------------------------------------------
// Auth / RBAC
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String  @map("password_hash")
  fullName     String  @map("full_name")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  programRoles UserProgramRole[]
  evaluations  PiEvaluation[]

  @@map("users")
}

enum ProgramRole {
  ADMIN
  PROGRAM_CHAIR
  FACULTY
  VIEWER

  @@map("program_role")
}

model UserProgramRole {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  programId String      @map("program_id")
  role      ProgramRole

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@map("user_program_roles")
}

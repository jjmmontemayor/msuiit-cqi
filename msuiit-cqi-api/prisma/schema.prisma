// MSU-IIT CQI data model.
// See ../../docs/schema.md for the full design rationale and ER diagram.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Catalog (institution-wide, program-independent)
// ---------------------------------------------------------------------------

model Program {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  curriculumCourses    CurriculumCourse[]
  plos                 Plo[]
  cohorts              Cohort[]
  curriculumVersions   CurriculumVersion[]
  students             Student[]
  userRoles            UserProgramRole[]
  mappingLevels        MappingLevel[]
  attainmentBenchmark  AttainmentBenchmark?
  faculty              Faculty[]

  @@map("programs")
}

model Course {
  id            String   @id @default(uuid())
  code          String   @unique
  title         String
  description   String?
  credits       Int?
  lectureHours  Int?     @map("lecture_hours")
  labHours      Int?     @map("lab_hours")
  prerequisites String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  curriculumCourses CurriculumCourse[]
  clos              Clo[]
  courseOfferings   CourseOffering[]

  @@map("courses")
}

// Weights are program-specific (each program defines its own set of levels
// and tunes how each translates into a weighted score), so this is one row
// per (program, code) rather than a fixed global triad. Admins can add, edit,
// or delete levels freely (subject to a level in use by existing CLO
// mappings being protected from deletion) -- see MappingLevelsService.
//
// `code` is just a short label (historically "I"/"P"/"D", but any string) --
// mappings reference a level by its `id` (CloPloMapping.mappingLevelId /
// CloPiMapping.mappingLevelId), not by `code`, so renaming a level's code
// doesn't require touching any mapping data. `displayCode` is what badges
// and selects actually render (defaults to `code` at creation, but can
// diverge, e.g. a program could show "B/A/M" while `code` stays "I/P/D").
model MappingLevel {
  id          String @id @default(uuid())
  programId   String @map("program_id")
  code        String
  displayCode String @map("display_code")
  label       String
  weight      Int

  program        Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  cloPloMappings CloPloMapping[]
  cloPiMappings  CloPiMapping[]

  @@unique([programId, code])
  @@map("mapping_levels")
}

// One row per program: the score threshold below which a student's CLO
// attainment is flagged in reports -- source workbook calls this the
// "Performance Criteria" (Benchmark/Target, both 70% there) and uses it to
// decide "Good Standing" per student and the ✅/❌ "CQI Alert" per course.
model AttainmentBenchmark {
  id         String @id @default(uuid())
  programId  String @unique @map("program_id")
  percentage Int    @default(70)

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("attainment_benchmarks")
}

enum Semester {
  FIRST
  SECOND
  SUMMER

  @@map("semester")
}

model AcademicTerm {
  id              String   @id @default(uuid())
  schoolYearStart Int      @map("school_year_start")
  schoolYearEnd   Int      @map("school_year_end")
  semester        Semester
  label           String

  courseOfferings CourseOffering[]

  @@unique([schoolYearStart, schoolYearEnd, semester])
  @@map("academic_terms")
}

// ---------------------------------------------------------------------------
// Program structure
// ---------------------------------------------------------------------------

model CurriculumCourse {
  id                     String  @id @default(uuid())
  programId              String  @map("program_id")
  courseId               String  @map("course_id")
  electiveGroup          String? @map("elective_group")
  yearLevel              Int?    @map("year_level")
  term                   String?
  displayOrder           Int     @default(0) @map("display_order")
  isActive               Boolean @default(true) @map("is_active")
  // Designates this course (within this program's curriculum) as one whose
  // CLO-PLO mappings are the ones formally used for PLO assessment/reporting,
  // as opposed to every course that happens to have a mapping. Lets the
  // CLO-PLO mapping tab highlight and filter down to just these courses.
  isPloAssessmentTarget  Boolean @default(false) @map("is_plo_assessment_target")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([programId, courseId])
  @@map("curriculum_courses")
}

model Plo {
  id           String @id @default(uuid())
  programId    String @map("program_id")
  code         String
  description  String
  displayOrder Int    @default(0) @map("display_order")

  program               Program                @relation(fields: [programId], references: [id], onDelete: Cascade)
  performanceIndicators PerformanceIndicator[]
  cloMappings           CloPloMapping[]

  @@unique([programId, code])
  @@map("plos")
}

model PerformanceIndicator {
  id          String @id @default(uuid())
  ploId       String @map("plo_id")
  code        String
  description String
  // The assessment instrument used to measure this PI in general (e.g. "Board
  // exam item analysis"), distinct from CloPiMapping.assessmentMethod which
  // records how one specific CLO's evidence toward this PI is assessed.
  assessment   String? @map("assessment")
  displayOrder Int     @default(0) @map("display_order")

  plo           Plo             @relation(fields: [ploId], references: [id], onDelete: Cascade)
  cloPiMappings CloPiMapping[]
  evaluations   PiEvaluation[]

  @@unique([ploId, code])
  @@map("performance_indicators")
}

// A curriculum revision, e.g. "2018 Rev.3" (matching how the source BOR
// curriculum document versions the whole program). CLOs and CLO-PLO/PI
// mappings are defined against a version, independent of any cohort/batch --
// that work can happen before a batch exists, or before a batch is assigned
// to it. Multiple cohorts admitted under the same curriculum share one
// version, so a new cohort doesn't need its CLOs/mappings duplicated unless
// the curriculum actually changed (see Clo/CloPloMapping below).
model CurriculumVersion {
  id          String   @id @default(uuid())
  programId   String   @map("program_id")
  code        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  program        Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  cohorts        Cohort[]
  clos           Clo[]
  cloPloMappings CloPloMapping[]
  cloPiMappings  CloPiMapping[]

  @@unique([programId, code])
  @@map("curriculum_versions")
}

// `curriculumVersionId` scopes the CLO to a curriculum revision, not a
// batch: definition work (CLOs, CLO-PLO/PI mappings) is independent of
// which cohorts exist or have been assigned to that version. `isLocked`
// marks a CLO (and by extension its mappings) as finalized for reporting; a
// locked CLO can't be edited or deleted in place — instead, a new CLO row
// is created under the next curriculum version, leaving the locked one and
// its historical mappings/attainments untouched.
model Clo {
  id                  String  @id @default(uuid())
  courseId            String  @map("course_id")
  curriculumVersionId String  @map("curriculum_version_id")
  code                String
  description         String
  displayOrder        Int     @default(0) @map("display_order")
  isLocked            Boolean @default(false) @map("is_locked")

  course            Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  curriculumVersion CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  ploMappings       CloPloMapping[]
  piMappings        CloPiMapping[]
  attainments       CloAttainment[]

  @@unique([courseId, code, curriculumVersionId])
  @@map("clos")
}

// The CLO->PLO mapping level is the primary fact — every course's CLOs are
// mapped straight to all applicable PLOs (see the workbook's `Mapping`
// sheet, which has no PI column at all). PI-level refinement (which PIs
// within that PLO the CLO evidences, and at what level) is recorded
// separately in CloPiMapping, since a single CLO can evidence more than one
// PI in the same PLO at different levels.
//
// `curriculumVersionId` scopes the mapping to a curriculum revision, the
// same way Clo is scoped: curricula get revised over time, so the same CLO
// can map to a PLO at a different level (or not at all) in a later version.
// Each version therefore owns its own complete mapping set rather than
// sharing one global table.
model CloPloMapping {
  id                  String @id @default(uuid())
  cloId               String @map("clo_id")
  ploId               String @map("plo_id")
  curriculumVersionId String @map("curriculum_version_id")
  mappingLevelId      String @map("mapping_level_id")

  clo               Clo               @relation(fields: [cloId], references: [id], onDelete: Cascade)
  plo               Plo               @relation(fields: [ploId], references: [id], onDelete: Cascade)
  curriculumVersion CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  mappingLevel      MappingLevel      @relation(fields: [mappingLevelId], references: [id])

  @@unique([cloId, ploId, curriculumVersionId])
  @@map("clo_plo_mappings")
}

// PI-level refinement of a CLO->PLO mapping: requires the CLO to already map
// to the PI's PLO (see CloPloMapping) before it can be set, but tracks its
// own level and assessment method per (CLO, PI) pair, independent of the
// other PIs under the same PLO.
model CloPiMapping {
  id                  String  @id @default(uuid())
  cloId               String  @map("clo_id")
  piId                String  @map("pi_id")
  curriculumVersionId String  @map("curriculum_version_id")
  mappingLevelId      String  @map("mapping_level_id")
  assessmentMethod    String? @map("assessment_method")

  clo               Clo                  @relation(fields: [cloId], references: [id], onDelete: Cascade)
  pi                PerformanceIndicator @relation(fields: [piId], references: [id], onDelete: Cascade)
  curriculumVersion CurriculumVersion    @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  mappingLevel      MappingLevel         @relation(fields: [mappingLevelId], references: [id])

  @@unique([cloId, piId, curriculumVersionId])
  @@map("clo_pi_mappings")
}

// ---------------------------------------------------------------------------
// People and enrollment
// ---------------------------------------------------------------------------

// `curriculumVersionId` is nullable: a batch can be created before its
// curriculum version has been decided, and a version can be defined before
// any batch is assigned to it -- the two workflows (admitting a batch,
// writing/mapping CLOs) run independently and converge when someone assigns
// one to the other.
model Cohort {
  id                  String  @id @default(uuid())
  programId           String  @map("program_id")
  curriculumVersionId String? @map("curriculum_version_id")
  code                String
  startYear           Int     @map("start_year")
  endYear             Int     @map("end_year")
  description         String?

  program           Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  curriculumVersion CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id], onDelete: SetNull)
  students          Student[]
  evaluations       PiEvaluation[]
  cohortAdvisers    CohortAdviser[]

  @@unique([programId, code])
  @@map("cohorts")
}

// Per-program faculty roster. Not tied to a User/login account (this app
// doesn't have auth-gated faculty accounts yet) -- a lightweight roster so a
// faculty member can be assigned as an adviser to one of the program's
// batches.
model Faculty {
  id        String  @id @default(uuid())
  programId String  @map("program_id")
  name      String
  email     String?
  isActive  Boolean @default(true) @map("is_active")

  program        Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  cohortAdvisers CohortAdviser[]

  @@map("faculty")
}

// Faculty <-> Cohort adviser assignment. A batch can have more than one
// adviser (e.g. co-advisers, or a handoff mid-batch), and a faculty member
// can advise more than one batch at a time, hence a plain join table rather
// than a single adviserId column on Cohort or Student.
model CohortAdviser {
  id        String @id @default(uuid())
  cohortId  String @map("cohort_id")
  facultyId String @map("faculty_id")

  cohort  Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([cohortId, facultyId])
  @@map("cohort_advisers")
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  WITHDRAWN

  @@map("student_status")
}

// `cohortId` is nullable: a student who shows up in an uploaded CLO
// attainment sheet but isn't part of this program's tracked roster (found
// no batch to place them in) still gets a Student row so their
// enrollments/attainments can be recorded against the course, but with no
// cohort -- which is exactly what excludes them from every cohort-scoped
// report (CLO/PLO Attainments, weighted PLO rollups, etc.) without needing
// a separate flag.
model Student {
  id            String        @id @default(uuid())
  studentNumber String        @unique @map("student_number")
  firstName     String        @map("first_name")
  lastName      String        @map("last_name")
  programId     String        @map("program_id")
  cohortId      String?       @map("cohort_id")
  status        StudentStatus @default(ACTIVE)

  program     Program      @relation(fields: [programId], references: [id], onDelete: Restrict)
  cohort      Cohort?      @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]

  @@map("students")
}

model CourseOffering {
  id             String  @id @default(uuid())
  courseId       String  @map("course_id")
  academicTermId String  @map("academic_term_id")
  section        String?
  instructorName String? @map("instructor_name")

  course            Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  academicTerm      AcademicTerm        @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  enrollments       Enrollment[]
  learningPlanEntries LearningPlanEntry[]

  @@unique([courseId, academicTermId, section])
  @@map("course_offerings")
}

// A course's learning plan varies by who's actually teaching it and when --
// two offerings of the same course (different department, instructor, or
// term) can have entirely different week breakdowns, CO counts, and
// activities (see docs/source-data sample syllabi). So this is scoped to
// CourseOffering, not Course. `coLabels` is free text (e.g. "CO1,CO3") rather
// than a Clo FK: Clo rows are cohort-scoped, and an offering doesn't map
// cleanly to a single cohort, so a hard link would force an arbitrary choice.
model LearningPlanEntry {
  id                String  @id @default(uuid())
  courseOfferingId  String  @map("course_offering_id")
  weekLabel         String  @map("week_label")
  displayOrder      Int     @default(0) @map("display_order")
  topics            String
  lessonOutcome     String? @map("lesson_outcome")
  coLabels          String? @map("co_labels")
  methodology       String?
  learningResources String? @map("learning_resources")
  assessment        String?

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@map("learning_plan_entries")
}

model Enrollment {
  id               String @id @default(uuid())
  studentId        String @map("student_id")
  courseOfferingId String @map("course_offering_id")
  // What year level the student was in when they took this specific
  // course -- distinct from the course offering's academic term (a
  // calendar period), since two students in the same offering can be at
  // different points in their own program (e.g. one on-track, one
  // repeating), and the same course can be taken at different year levels
  // across cohorts as curricula get revised.
  yearLevel        Int?   @map("year_level")

  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering  @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  cloAttainments CloAttainment[]

  @@unique([studentId, courseOfferingId])
  @@map("enrollments")
}

// ---------------------------------------------------------------------------
// Facts
// ---------------------------------------------------------------------------

model CloAttainment {
  id           String  @id @default(uuid())
  enrollmentId String  @map("enrollment_id")
  cloId        String  @map("clo_id")
  score        Decimal @db.Decimal(5, 2)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  clo        Clo        @relation(fields: [cloId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, cloId])
  @@map("clo_attainments")
}

// ---------------------------------------------------------------------------
// Evaluation (narrative)
// ---------------------------------------------------------------------------

enum EvaluationStatus {
  DRAFT
  FINAL

  @@map("evaluation_status")
}

model PiEvaluation {
  id                   String           @id @default(uuid())
  piId                 String           @map("pi_id")
  cohortId             String           @map("cohort_id")
  benchmarkDescription String?          @map("benchmark_description")
  targetPercentage     Decimal?         @map("target_percentage") @db.Decimal(5, 2)
  resultsNarrative     String?          @map("results_narrative")
  status               EvaluationStatus @default(DRAFT)
  createdById          String?          @map("created_by")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  pi        PerformanceIndicator @relation(fields: [piId], references: [id], onDelete: Cascade)
  cohort    Cohort               @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  createdBy User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([piId, cohortId])
  @@map("pi_evaluations")
}

// ---------------------------------------------------------------------------
// Auth / RBAC
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String  @map("password_hash")
  fullName     String  @map("full_name")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  programRoles UserProgramRole[]
  evaluations  PiEvaluation[]

  @@map("users")
}

enum ProgramRole {
  ADMIN
  PROGRAM_CHAIR
  FACULTY
  VIEWER

  @@map("program_role")
}

model UserProgramRole {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  programId String      @map("program_id")
  role      ProgramRole

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@map("user_program_roles")
}
